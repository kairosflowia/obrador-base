# Estas variables de marca (NEXT_PUBLIC_BRAND_*, NEXT_PUBLIC_COLOR_*,
# NEXT_PUBLIC_FONT_*, NEXT_PUBLIC_IMAGE_*, NEXT_PUBLIC_CONTACT_*, etc.) solo
# actúan como valor de fábrica/fallback. En runtime, la fuente de verdad es
# la tabla app_settings (claves "marca.*"), editable desde
# /admin/configuracion/marca sin necesidad de redeploy.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_SHORT_NAME=
NEXT_PUBLIC_BRAND_TAGLINE=
NEXT_PUBLIC_BRAND_LOGO=
NEXT_PUBLIC_BRAND_ICON=
NEXT_PUBLIC_BRAND_APPLE_ICON=
NEXT_PUBLIC_COLOR_BACKGROUND=
NEXT_PUBLIC_COLOR_FOREGROUND=
NEXT_PUBLIC_COLOR_PRIMARY=
NEXT_PUBLIC_COLOR_PRIMARY_HOVER=
NEXT_PUBLIC_COLOR_ACCENT=
NEXT_PUBLIC_COLOR_SECONDARY=
NEXT_PUBLIC_COLOR_SURFACE=
NEXT_PUBLIC_COLOR_SURFACE_SUNKEN=
NEXT_PUBLIC_COLOR_TEXT_MUTED=
NEXT_PUBLIC_COLOR_SUCCESS=
NEXT_PUBLIC_COLOR_SUCCESS_SURFACE=
NEXT_PUBLIC_COLOR_WARNING=
NEXT_PUBLIC_COLOR_WARNING_SURFACE=
NEXT_PUBLIC_COLOR_ERROR=
NEXT_PUBLIC_COLOR_ERROR_SURFACE=
NEXT_PUBLIC_COLOR_INFORMATION=
NEXT_PUBLIC_COLOR_INFORMATION_SURFACE=
NEXT_PUBLIC_COLOR_BORDER=
NEXT_PUBLIC_COLOR_BORDER_STRONG=
NEXT_PUBLIC_FONT_DISPLAY=
NEXT_PUBLIC_FONT_BODY=
NEXT_PUBLIC_RADIUS_SMALL=
NEXT_PUBLIC_RADIUS_MEDIUM=
NEXT_PUBLIC_RADIUS_LARGE=
NEXT_PUBLIC_RADIUS_PILL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_CITY=
NEXT_PUBLIC_PROVINCE=
NEXT_PUBLIC_POSTAL_CODE=
NEXT_PUBLIC_COUNTRY=
NEXT_PUBLIC_TIMEZONE=
NEXT_PUBLIC_HERO_TITLE=
NEXT_PUBLIC_HERO_DESCRIPTION=
NEXT_PUBLIC_FOOTER_DESCRIPTION=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_SUBSCRIPTIONS_NAME=
NEXT_PUBLIC_IMAGE_HERO=
NEXT_PUBLIC_IMAGE_OBRADOR=
NEXT_PUBLIC_IMAGE_OBRADOR_PROCESS=
NEXT_PUBLIC_IMAGE_TEAM=
NEXT_PUBLIC_IMAGE_INSTITUTIONAL=
NEXT_PUBLIC_IMAGE_SUBSCRIPTIONS=
NEXT_PUBLIC_IMAGE_PRODUCT_FALLBACK=
NEXT_PUBLIC_SEO_TITLE=
NEXT_PUBLIC_SEO_DESCRIPTION=
NEXT_PUBLIC_SOCIAL_IMAGE=
# Preset inicial: BASIC, COMMERCE ou FULL. FULL mantém a base completa.
NEXT_PUBLIC_PRODUCT_PRESET=FULL
# Impede serviços reais e permite checkout/reset de demonstração.
NEXT_PUBLIC_DEMO_MODE=false
# Overrides opcionais. Deixa vazio para herdar o preset; usa true/false para alterar uma flag.
NEXT_PUBLIC_FEATURE_CATALOG=
NEXT_PUBLIC_FEATURE_ONLINE_ORDERS=
NEXT_PUBLIC_FEATURE_CUSTOMER_ACCOUNTS=
NEXT_PUBLIC_FEATURE_PAYMENTS=
NEXT_PUBLIC_FEATURE_INVENTORY=
NEXT_PUBLIC_FEATURE_AVAILABILITY=
NEXT_PUBLIC_FEATURE_PRODUCTION=
NEXT_PUBLIC_FEATURE_PICKUP_POINTS=
NEXT_PUBLIC_FEATURE_SUBSCRIPTIONS=
NEXT_PUBLIC_FEATURE_NEWSLETTER=
NEXT_PUBLIC_FEATURE_ANALYTICS=
NEXT_PUBLIC_FEATURE_NOTIFICATIONS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca uses el prefijo NEXT_PUBLIC_ para esta clave.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional pero recomendado en producción: protege /api/cron/availability de
# invocaciones externas. Vercel Cron la añade automáticamente como cabecera.
CRON_SECRET=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=
RESEND_WEBHOOK_SECRET=
EMAIL_PROVIDER=fake
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_PROVIDER=fake
# Solo para una transición explícita y temporal; no establecer normalmente.
ALLOW_STRIPE_TEST_IN_PRODUCTION=
